{
  "name": "Email Alert \u2014 DNN Article Render Complete",
  "description": "Sends a Gmail alert when a DNN article's HeyGen video render reaches complete.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"production_status\") != null) and (.trigger.data.production_status == \"complete\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DnnArticle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_alert_dnn_article_render_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyRenderComplete",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyRenderComplete"
  }
}