{
  "name": "DNN Broadcast \u2192 Distribution Trigger (Ready)",
  "description": "When any DnnBroadcast reaches 'ready' status (final MP4 uploaded by n8n), fires the n8n distribution webhook to publish to LinkedIn, Facebook, Instagram, SMS, and email.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"ready\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DnnBroadcast"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dnn_broadcast_distribution_trigger_ready",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dnnTriggerDistribution",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dnnTriggerDistribution"
  }
}