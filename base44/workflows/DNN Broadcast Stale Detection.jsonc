{
  "name": "DNN Broadcast Stale Detection",
  "description": "Automatically flags a DnnBroadcast as needsReRender=true when script, clips, headlines, presenter, or format fields change, invalidating the current stitched MP4.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DnnBroadcast"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dnn_broadcast_stale_detection",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dnnMarkStaleOnEdit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dnnMarkStaleOnEdit"
  }
}