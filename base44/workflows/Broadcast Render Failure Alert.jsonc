{
  "name": "Broadcast Render Failure Alert",
  "description": "Sends a Twilio SMS to the admin whenever a DNN morning broadcast render fails",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"failed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DnnBroadcast"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "broadcast_render_failure_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dnnBroadcastFailAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dnnBroadcastFailAlert"
  }
}