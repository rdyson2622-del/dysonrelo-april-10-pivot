{
  "name": "LayoutTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string",
      "description": "Display name for this layout template"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "synced_to_heygen",
        "archived"
      ],
      "default": "approved",
      "description": "Lifecycle status \u2014 only 'approved' templates are used by the render pipeline"
    },
    "heygen_template_id": {
      "type": "string",
      "description": "HeyGen Master Template ID for the Template API (POST /v2/template/{template_id}/generate). When set, the render pipeline passes daily dialogue as text variables into this static template instead of generating raw avatar clips. The template locks all visual layout (studio background, dual-avatar framing, lower thirds) in HeyGen."
    },
    "reference_video_url": {
      "type": "string",
      "description": "Permanent MP4 URL of the broadcast that demonstrates this layout (the golden master reference file)"
    },
    "reference_broadcast_id": {
      "type": "string",
      "description": "ID of the DnnBroadcast record this layout was captured from"
    },
    "background": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "video"
          ],
          "default": "image"
        },
        "url": {
          "type": "string",
          "description": "Studio backdrop image/video URL"
        },
        "description": {
          "type": "string",
          "description": "Human description of the backdrop"
        }
      },
      "description": "Background matrix configuration"
    },
    "presenter_1": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "default": "Charlie"
        },
        "type": {
          "type": "string",
          "enum": [
            "avatar",
            "talking_photo"
          ],
          "default": "avatar"
        },
        "heygen_id": {
          "type": "string",
          "description": "HeyGen avatar_id or talking_photo_id"
        },
        "voice_id": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "description": "Presenter scale factor (0-1)"
        },
        "offset_x": {
          "type": "number",
          "description": "Horizontal offset (-1 to 1)"
        },
        "offset_y": {
          "type": "number",
          "description": "Vertical offset (-1 to 1)"
        },
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ],
          "default": "left"
        }
      },
      "description": "Presenter 1 (Charlie) positioning and avatar configuration"
    },
    "presenter_2": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "default": "Bob"
        },
        "type": {
          "type": "string",
          "enum": [
            "avatar",
            "talking_photo"
          ],
          "default": "talking_photo"
        },
        "heygen_id": {
          "type": "string",
          "description": "HeyGen avatar_id or talking_photo_id"
        },
        "voice_id": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "description": "Presenter scale factor (0-1)"
        },
        "offset_x": {
          "type": "number",
          "description": "Horizontal offset (-1 to 1)"
        },
        "offset_y": {
          "type": "number",
          "description": "Vertical offset (-1 to 1)"
        },
        "alignment": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ],
          "default": "right"
        }
      },
      "description": "Presenter 2 (Bob Dyson) positioning and talking photo configuration"
    },
    "dual_presenter_mode": {
      "type": "boolean",
      "default": true,
      "description": "When true, both presenters are visible on screen simultaneously throughout the broadcast"
    },
    "solution_panel": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "background_color": {
          "type": "string",
          "description": "Panel background hex color"
        },
        "border_color": {
          "type": "string",
          "description": "Panel border hex color"
        },
        "border_width_px": {
          "type": "number",
          "description": "Border width in pixels"
        },
        "border_radius_px": {
          "type": "number",
          "description": "Corner radius in pixels"
        },
        "position": {
          "type": "string",
          "enum": [
            "upper_center",
            "upper_left",
            "upper_right",
            "lower_center"
          ],
          "default": "upper_center"
        },
        "width_percent": {
          "type": "number",
          "description": "Panel width as percentage of frame"
        },
        "title_color": {
          "type": "string",
          "description": "Title text hex color"
        },
        "title_font_family": {
          "type": "string",
          "description": "Title font family"
        },
        "title_font_weight": {
          "type": "string",
          "description": "Title font weight"
        },
        "bullet_color": {
          "type": "string",
          "description": "Bullet text hex color"
        },
        "bullet_marker_color": {
          "type": "string",
          "description": "Bullet dot hex color"
        },
        "text_alignment": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        }
      },
      "description": "Solution panel overlay \u2014 the white presentation card with bullet points"
    },
    "affiliate_overlays": {
      "type": "object",
      "properties": {
        "logo_watermark": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to render an affiliate logo watermark on the broadcast"
            },
            "position": {
              "type": "string",
              "enum": [
                "top_left",
                "top_right",
                "bottom_left",
                "bottom_right"
              ],
              "default": "bottom_right",
              "description": "Screen corner for the watermark"
            },
            "opacity": {
              "type": "number",
              "default": 0.8,
              "description": "Watermark opacity (0-1)"
            },
            "scale_percent": {
              "type": "number",
              "default": 12,
              "description": "Watermark width as percentage of frame width"
            },
            "padding_px": {
              "type": "number",
              "default": 24,
              "description": "Padding from screen edge in pixels"
            },
            "logo_url": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate at render time. Leave blank in the golden master; the pipeline injects each agent's logo URL."
            }
          },
          "description": "Affiliate logo watermark \u2014 a variable placeholder hook. The position/opacity/scale are part of the golden master layout, but the logo_url is injected per-affiliate."
        },
        "agent_name_card": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to render a bottom-third agent name card"
            },
            "position": {
              "type": "string",
              "enum": [
                "bottom_left",
                "bottom_right",
                "bottom_center"
              ],
              "default": "bottom_left",
              "description": "Position of the agent name card"
            },
            "background_color": {
              "type": "string",
              "default": "#0a0a0a",
              "description": "Card background hex color"
            },
            "text_color": {
              "type": "string",
              "default": "#D4AF37",
              "description": "Agent name text hex color"
            },
            "font_family": {
              "type": "string",
              "default": "Inter, sans-serif",
              "description": "Agent name font family"
            },
            "font_size_px": {
              "type": "number",
              "default": 18,
              "description": "Agent name font size in pixels"
            },
            "font_weight": {
              "type": "string",
              "default": "bold",
              "description": "Agent name font weight"
            },
            "border_radius_px": {
              "type": "number",
              "default": 8,
              "description": "Card corner radius in pixels"
            },
            "padding_px": {
              "type": "number",
              "default": 12,
              "description": "Card padding in pixels"
            },
            "agent_name": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate at render time. Leave blank in the golden master; the pipeline injects each agent's display name."
            },
            "agent_title": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate at render time (e.g. 'Realtor\u00ae | Dyson & Dyson')."
            },
            "brokerage_name": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate at render time."
            }
          },
          "description": "Bottom-third agent name card \u2014 a variable placeholder hook. Styling/position are part of the golden master, but agent_name/title/brokerage are injected per-affiliate."
        },
        "localization_footer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to render a localization footer bar"
            },
            "background_color": {
              "type": "string",
              "default": "#0a0a0a",
              "description": "Footer bar background hex color"
            },
            "text_color": {
              "type": "string",
              "default": "#D4AF37",
              "description": "Footer text hex color"
            },
            "font_family": {
              "type": "string",
              "default": "Inter, sans-serif"
            },
            "font_size_px": {
              "type": "number",
              "default": 14
            },
            "market_city": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate (e.g. 'Serving Greater Los Angeles')."
            },
            "market_state": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate."
            },
            "custom_tagline": {
              "type": "string",
              "description": "DYNAMIC HOOK \u2014 populated per-affiliate (e.g. 'Your Local Real Estate Authority')."
            }
          },
          "description": "Localization footer bar \u2014 a variable placeholder hook for market city/state and custom tagline injection."
        }
      },
      "description": "AFFILIATE VARIABLE PLACEHOLDERS \u2014 dynamic hooks for per-affiliate localization. These overlays are structurally separate from the golden master alignment parameters (presenter positions, background, solution panel). The position/styling is locked in the golden master, but the actual content (logo_url, agent_name, market_city) is injected per-affiliate at render time. NOT included in layoutHash computation \u2014 swapping affiliate branding never triggers a re-render of the golden master."
    },
    "video_dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "description": "Output video resolution"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this layout template"
    }
  },
  "required": [
    "template_name",
    "status",
    "reference_video_url"
  ]
}