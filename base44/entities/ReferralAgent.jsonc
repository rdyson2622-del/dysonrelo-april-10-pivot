{
  "name": "ReferralAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent's full name"
    },
    "preferred_name": {
      "type": "string",
      "description": "First name/nickname the agent prefers to be addressed by in outreach"
    },
    "photo_url": {
      "type": "string",
      "description": "Agent headshot shown on their portal profile"
    },
    "agreement_file_url": {
      "type": "string",
      "description": "Signed Independent Contractor Agreement with The Dyson & Dyson Companies, Inc \u2014 uploaded file, viewable with one click from the admin roster."
    },
    "portal_slug": {
      "type": "string",
      "description": "URL slug for this agent's personal referral portal page (e.g. jane-doe)"
    },
    "target_territories": {
      "type": "string",
      "description": "Residential territories/markets this agent's sphere is in, for referral matching"
    },
    "brokerage": {
      "type": "string",
      "description": "Brokerage name (if any) or affiliation"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "phone": {
      "type": "string",
      "description": "Agent's phone number"
    },
    "email": {
      "type": "string",
      "description": "Agent's email"
    },
    "status": {
      "type": "string",
      "default": "Referral Agent Subscriber",
      "description": "Affiliate status label (e.g. 'Referral Agent Subscriber'). Referral agents do not list or sell \u2014 they only refer buyer/seller leads to our full-time affiliate agents for a referral fee."
    },
    "dre_license_number": {
      "type": "string",
      "description": "California DRE license number"
    },
    "license_exp_date": {
      "type": "string",
      "format": "date",
      "description": "DRE license expiration date \u2014 used to trigger renewal alerts"
    },
    "license_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "unverified"
      ],
      "default": "unverified",
      "description": "Current DRE license status. Starts unverified until the agent confirms it or we check the DRE registry."
    },
    "license_confirmed_by_agent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the agent logged in and confirmed their license number/expiration date is accurate \u2014 required before relying on it for compliance tracking, since some records may be stale."
    },
    "last_dre_audit_check": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the DRE public registry was checked against this record"
    },
    "renewal_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last renewal-reminder alert was sent, so alerts don't repeat"
    },
    "initial_welcome_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the initial subscriber welcome/re-introduction message was sent to this agent"
    },
    "news_subscriber": {
      "type": "boolean",
      "default": true,
      "description": "Whether this agent receives approved DNN news sends"
    },
    "weekly_update_subscriber": {
      "type": "boolean",
      "default": true,
      "description": "Whether this agent receives the weekly recap email"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this referral agent"
    },
    "joined_at": {
      "type": "string",
      "format": "date",
      "description": "Date this agent joined the referral network"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}