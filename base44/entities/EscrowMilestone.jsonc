{
  "name": "EscrowMilestone",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string",
      "description": "The Brokerage entity ID this milestone belongs to. Set by sync functions. Platform admins see all; brokerage_admin users see only their own."
    },
    "client_id": {
      "type": "string",
      "description": "Associated RelocationClient ID"
    },
    "property_address": {
      "type": "string",
      "description": "Property address for this escrow"
    },
    "escrow_company": {
      "type": "string",
      "description": "Escrow company name"
    },
    "escrow_number": {
      "type": "string",
      "description": "Escrow transaction number"
    },
    "milestone_type": {
      "type": "string",
      "enum": [
        "initial_deposit",
        "inspection",
        "inspection_contingency_release",
        "appraisal",
        "loan_approval",
        "homeowners_insurance",
        "final_walkthrough",
        "release_of_contingencies",
        "clear_to_close",
        "closing_date",
        "funding",
        "moving_date",
        "utility_activation",
        "other"
      ],
      "description": "Type of escrow milestone"
    },
    "milestone_name": {
      "type": "string",
      "description": "Custom name for this milestone"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Target date for this milestone"
    },
    "due_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Specific date/time if known (e.g., closing time)"
    },
    "description": {
      "type": "string",
      "description": "Details about this milestone (e.g., loan contingency deadline, inspection deadline)"
    },
    "responsible_party": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "escrow_company",
        "lender",
        "title_company",
        "inspector",
        "appraiser",
        "client_action"
      ],
      "description": "Who is responsible for completing this milestone"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "waived",
        "at_risk",
        "failed"
      ],
      "default": "pending",
      "description": "Current status"
    },
    "days_until_due": {
      "type": "number",
      "description": "Calculated days remaining (for sorting/alerts)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this milestone"
    },
    "extracted_from": {
      "type": "string",
      "description": "Filename or document name this was extracted from"
    },
    "alert_tier": {
      "type": "string",
      "enum": [
        "internal",
        "client"
      ],
      "default": "internal",
      "description": "Visibility tier for this alert. internal = Agent/TC/Compliance see it first to fix before stressing the client. client = escalated to buyer/seller."
    },
    "alert_status": {
      "type": "string",
      "enum": [
        "raised",
        "acknowledged",
        "mitigating",
        "resolved_internal",
        "escalated_to_client"
      ],
      "default": "raised",
      "description": "Two-tier alert workflow. raised=just detected, acknowledged=agent/TC saw it, mitigating=working on a fix (often via EscrowIssue resolver), resolved_internal=fixed without ever notifying client, escalated_to_client=could not fix internally, client now notified."
    },
    "acknowledged_by_name": {
      "type": "string",
      "description": "Name of the agent/TC who acknowledged the alert."
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the buyer/seller has been notified of this alert."
    },
    "client_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "mitigation_notes": {
      "type": "string",
      "description": "Notes from the agent/TC on how the issue was mitigated or why it was escalated."
    }
  },
  "required": [
    "client_id",
    "milestone_type",
    "due_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}