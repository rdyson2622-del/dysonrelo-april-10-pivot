{
  "name": "ActiveRelocationAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent's full name"
    },
    "brokerage": {
      "type": "string",
      "description": "Brokerage name"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "phone": {
      "type": "string",
      "description": "Agent's phone number"
    },
    "email": {
      "type": "string",
      "description": "Agent's email"
    },
    "status": {
      "type": "string",
      "default": "Relocation Agent Subscriber",
      "description": "Affiliate status label (e.g. 'Relocation Agent Subscriber')"
    },
    "dre_license_number": {
      "type": "string",
      "description": "California DRE license number"
    },
    "license_exp_date": {
      "type": "string",
      "format": "date",
      "description": "DRE license expiration date \u2014 used to trigger renewal alerts"
    },
    "renewal_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last renewal-reminder alert was sent, so alerts don't repeat"
    },
    "initial_welcome_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the initial subscriber welcome/re-introduction message was sent to this agent"
    },
    "news_subscriber": {
      "type": "boolean",
      "default": true,
      "description": "Whether this agent receives approved DNN news sends"
    },
    "weekly_update_subscriber": {
      "type": "boolean",
      "default": true,
      "description": "Whether this agent receives the weekly recap email"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this affiliate"
    },
    "joined_at": {
      "type": "string",
      "format": "date",
      "description": "Date this agent joined as an active relocation affiliate"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}