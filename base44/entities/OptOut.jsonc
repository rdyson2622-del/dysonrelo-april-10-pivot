{
  "name": "OptOut",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Phone number that opted out"
    },
    "source": {
      "type": "string",
      "enum": [
        "twilio_sms",
        "manual"
      ],
      "description": "How the opt-out was recorded"
    },
    "opted_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the opt-out occurred"
    },
    "campaign_city": {
      "type": "string",
      "description": "Which city batch this was for (if applicable)"
    },
    "reason": {
      "type": "string",
      "description": "Opt-out reason or notes"
    }
  },
  "required": [
    "phone",
    "source",
    "opted_out_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}