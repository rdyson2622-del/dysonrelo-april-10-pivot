{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent full name"
    },
    "email": {
      "type": "string",
      "description": "Agent email address"
    },
    "phone": {
      "type": "string",
      "description": "Agent phone number"
    },
    "broker": {
      "type": "string",
      "description": "Brokerage/company name"
    },
    "office_location": {
      "type": "string",
      "description": "Office city and state"
    },
    "specialty_markets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cities/markets agent specializes in"
    },
    "license_number": {
      "type": "string",
      "description": "Real estate license number"
    },
    "years_experience": {
      "type": "number",
      "description": "Years in real estate"
    },
    "referral_fee_standard": {
      "type": "number",
      "default": 25,
      "description": "Standard referral fee percentage"
    },
    "mgmt_fee_rate": {
      "type": "number",
      "default": 15,
      "description": "Our management fee percentage"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether agent is active in network"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about agent"
    }
  },
  "required": [
    "name",
    "email",
    "broker",
    "office_location"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}