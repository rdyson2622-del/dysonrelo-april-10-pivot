{
  "name": "ReferralAgentSectionContent",
  "type": "object",
  "properties": {
    "section_key": {
      "type": "string",
      "enum": [
        "process",
        "forms"
      ],
      "description": "Which explainer section this content belongs to: process = the referral process walkthrough, forms = the paperwork/agreement explainer"
    },
    "headline": {
      "type": "string",
      "description": "Section headline"
    },
    "subheadline": {
      "type": "string",
      "description": "Supporting line under the headline"
    },
    "video_url": {
      "type": "string",
      "description": "Optional explainer video URL (MP4)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered steps (for process) or bullet points (for forms)"
    },
    "cta_label": {
      "type": "string",
      "description": "Optional call-to-action button label"
    },
    "cta_url": {
      "type": "string",
      "description": "Where the CTA button links to"
    },
    "is_live": {
      "type": "boolean",
      "default": true,
      "description": "Whether this content is currently shown to visitors"
    }
  },
  "required": [
    "section_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}