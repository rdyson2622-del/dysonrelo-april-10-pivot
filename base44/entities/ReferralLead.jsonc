{
  "name": "ReferralLead",
  "type": "object",
  "properties": {
    "referral_type": {
      "type": "string",
      "enum": [
        "relocation_client",
        "vendor",
        "agent",
        "other"
      ],
      "default": "relocation_client",
      "description": "What kind of referral this is: relocation_client = someone relocating, vendor = a vendor being referred to join the network, agent = a real estate agent being referred to join the network, other = anything else"
    },
    "referred_name": {
      "type": "string",
      "description": "Name of the person being referred"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the person being referred"
    },
    "referred_phone": {
      "type": "string",
      "description": "Phone number of the person being referred (optional)"
    },
    "referred_company": {
      "type": "string",
      "description": "Company/brokerage name of the person being referred, for vendor or agent referral types (optional)"
    },
    "destination_city": {
      "type": "string",
      "description": "Destination city they're relocating to (relocation_client type only)"
    },
    "destination_state": {
      "type": "string",
      "description": "Destination state they're relocating to (relocation_client type only)"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of the person who submitted the referral"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the person who submitted the referral"
    },
    "referrer_role": {
      "type": "string",
      "description": "Portal role of the person submitting the referral (e.g. client, agent, vendor, broker), if known"
    },
    "notes": {
      "type": "string",
      "description": "Any additional context provided by the referrer"
    },
    "source": {
      "type": "string",
      "default": "Referral Page",
      "description": "Where this referral was submitted from (e.g. Referral Page, Referral Pill)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "accepted",
        "declined"
      ],
      "default": "new",
      "description": "Admin review status of this referral lead"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an admin accepted this lead"
    },
    "accepted_by": {
      "type": "string",
      "description": "Admin email who accepted this lead"
    }
  },
  "required": [
    "referred_name",
    "referred_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}