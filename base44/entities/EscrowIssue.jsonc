{
  "name": "EscrowIssue",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string",
      "description": "Brokerage entity ID this issue belongs to."
    },
    "escrow_number": {
      "type": "string",
      "description": "Escrow transaction number this issue is attached to."
    },
    "property_address": {
      "type": "string",
      "description": "Property address for context."
    },
    "milestone_ref": {
      "type": "string",
      "description": "The milestone_type or milestone_name this issue was raised on."
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "missing_docs",
        "deadline_missed",
        "buyer_reneg",
        "lending_failure",
        "loan_change",
        "inspection_failure",
        "appraisal_gap",
        "title_issue",
        "seller_delay",
        "buyer_delay",
        "other"
      ],
      "description": "Category of the escrow issue."
    },
    "issue_description": {
      "type": "string",
      "description": "Free-text description of the problem from the user."
    },
    "llm_solution": {
      "type": "string",
      "description": "Deep LLM-generated solution / recommendation for resolving the issue."
    },
    "suggested_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of action steps the LLM recommends."
    },
    "detour_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "responsible_party": {
            "type": "string"
          }
        }
      },
      "description": "Suggested detour stages to redirect the roadmap around this issue."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "solution_offered",
        "applied",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "Lifecycle: open=raised, solution_offered=LLM responded, applied=detour added to roadmap, resolved=closed, dismissed=rejected"
    },
    "raised_by_name": {
      "type": "string",
      "description": "Name of the user who raised the issue."
    },
    "raised_by_role": {
      "type": "string",
      "description": "Portal role of the raiser."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "escrow_number",
    "issue_type",
    "issue_description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}