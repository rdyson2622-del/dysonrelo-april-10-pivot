{
  "name": "RelocationProject",
  "type": "object",
  "properties": {
    "clientName": {
      "type": "string",
      "description": "Relocating client's full name"
    },
    "originAddress": {
      "type": "string",
      "description": "Address of the home the client is selling"
    },
    "originListingPrice": {
      "type": "string",
      "description": "Asking or estimated price of the origin listing"
    },
    "destinationMetro": {
      "type": "string",
      "description": "Metro area / city the client is relocating to"
    },
    "destinationCriteria": {
      "type": "string",
      "description": "Destination search criteria \u2014 price range, school district, commute, property type"
    },
    "targetMoveDate": {
      "type": "string",
      "format": "date",
      "description": "Target move date"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_destination_agent",
        "agent_vetting_in_progress",
        "agent_assigned",
        "house_hunting",
        "in_escrow",
        "closed"
      ],
      "default": "needs_destination_agent",
      "description": "Current stage of the relocation pipeline"
    },
    "projectedReferralFee": {
      "type": "number",
      "description": "Projected gross referral commission on this deal"
    },
    "destinationAgentName": {
      "type": "string",
      "description": "Name of the vetted destination agent assigned to this client"
    },
    "destinationAgentPhone": {
      "type": "string"
    },
    "destinationAgentEmail": {
      "type": "string"
    },
    "tcName": {
      "type": "string",
      "description": "Name of the Transaction Coordinator who secured this deal"
    },
    "tcPhone": {
      "type": "string"
    },
    "tcEmail": {
      "type": "string"
    },
    "sendingAgentId": {
      "type": "string",
      "description": "User ID of the sending/relo agent who owns this project"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes on this project"
    },
    "is_dummy": {
      "type": "boolean",
      "default": false,
      "description": "When true, this is a placeholder sample record showing agents/admins what a project looks like. Hidden automatically once real projects exist."
    }
  },
  "required": [
    "clientName"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sendingAgentId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_dummy": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sendingAgentId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}