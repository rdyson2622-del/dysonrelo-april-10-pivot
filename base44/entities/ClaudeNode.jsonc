{
  "name": "ClaudeNode",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Node title shown in the navigation list"
    },
    "summary": {
      "type": "string",
      "description": "Short one-line description shown under the title"
    },
    "section": {
      "type": "string",
      "enum": [
        "departments",
        "agent_context",
        "skills_sops",
        "tools_integrations"
      ],
      "default": "agent_context",
      "description": "Main navigation section this node belongs to"
    },
    "subsection": {
      "type": "string",
      "description": "Sub-grouping within a section (e.g. 'Marketing', 'DNN News', 'Operations', 'Sales', 'Finance' for Departments). Leave empty for flat sections."
    },
    "google_doc_url": {
      "type": "string",
      "description": "Link to the Google Doc containing the full content. Clicking this node opens this URL."
    },
    "content": {
      "type": "string",
      "description": "Optional in-app content (markdown). Primary content lives in the linked Google Doc."
    },
    "is_priority": {
      "type": "boolean",
      "default": false,
      "description": "Marks priority nodes (e.g. claude.md master file) with a gold star badge"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "When true, only the user whose ID matches private_owner_id can view and edit this node. Hidden from all other users including admins."
    },
    "private_owner_id": {
      "type": "string",
      "description": "User ID of the sole owner who can access this node when is_private is true."
    },
    "node_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order within a section/subsection"
    }
  },
  "required": [
    "title",
    "section"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_private": {
            "$ne": true
          }
        },
        {
          "data.private_owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.is_private": {
                "$ne": true
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.private_owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.is_private": {
                "$ne": true
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.private_owner_id": "{{user.id}}"
        }
      ]
    }
  }
}