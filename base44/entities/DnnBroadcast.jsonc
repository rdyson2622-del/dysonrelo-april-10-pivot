{
  "name": "DnnBroadcast",
  "type": "object",
  "properties": {
    "show_name": {
      "type": "string",
      "description": "Display name for this broadcast e.g. 'Show 1', 'Show 2'"
    },
    "show_number": {
      "type": "number",
      "description": "Sequential show number for ordering"
    },
    "broadcast_date": {
      "type": "string",
      "format": "date",
      "description": "The date this broadcast covers (YYYY-MM-DD)"
    },
    "pipeline": {
      "type": "string",
      "enum": [
        "higgsfield_11labs"
      ],
      "default": "higgsfield_11labs",
      "description": "Render pipeline that produced this show \u2014 Higgsfield video + 11 Labs audio via n8n"
    },
    "script": {
      "type": "string",
      "description": "Full combined anchor script (legacy / backward compat). New pipeline stores scenes separately below."
    },
    "intro_script": {
      "type": "string",
      "description": "Scene 1 script \u2014 spoken by Charlie (intro/open). Gemini outputs this as a separate JSON key."
    },
    "content_script": {
      "type": "string",
      "description": "Scene 2 script \u2014 spoken by Bob (main content/explainer). Gemini outputs this as a separate JSON key."
    },
    "outro_script": {
      "type": "string",
      "description": "Scene 3 script \u2014 spoken by Charlie (close/outro). Gemini outputs this as a separate JSON key."
    },
    "content_bullets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Curated bullet points for Bob's content segment. Rendered as a timed whiteboard panel above Bob's box in the studio composite. If empty, bullets are auto-derived from content_script sentences."
    },
    "headlines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Headlines covered in this broadcast"
    },
    "presenter": {
      "type": "string",
      "enum": [
        "bob",
        "charlie"
      ],
      "default": "charlie",
      "description": "Primary anchor for this broadcast"
    },
    "format": {
      "type": "string",
      "enum": [
        "solo",
        "tag_team"
      ],
      "default": "solo",
      "description": "solo = single anchor video; tag_team = Charlie at desk + Bob remote box"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "charlie",
              "bob"
            ]
          },
          "script": {
            "type": "string"
          },
          "heygenId": {
            "type": "string"
          },
          "videoUrl": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "Ordered clip sequence for legacy tag_team per-clip rendering (deprecated \u2014 use intro_script/content_script/outro_script instead)"
    },
    "heygenId": {
      "type": "string",
      "description": "Render job id for the FULL multi-scene show \u2014 set by n8n after single dispatch. One id = one stitched MP4."
    },
    "videoUrl": {
      "type": "string",
      "description": "Permanent CDN URL of the final stitched MP4 (all 3 scenes combined) \u2014 set by n8n after cloud upload."
    },
    "compositedVideoUrl": {
      "type": "string",
      "description": "Final MP4 with the DNN studio background BAKED IN (studio bg + anchor box). This is the version distributed to LinkedIn/Facebook/Instagram so social posts show the full studio set, not the raw avatar."
    },
    "compositedRenderId": {
      "type": "string",
      "description": "Studio composite render job id (tracked so the poller can finish the bake)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "script_ready",
        "rendering",
        "processing",
        "ready",
        "compositing",
        "completed",
        "failed"
      ],
      "default": "draft",
      "description": "3-stage pipeline lifecycle: draft=Scripting, rendering=render dispatched, processing=awaiting callback, ready=MP4 uploaded, compositing=studio bg baking, completed=Published, failed=error"
    },
    "prompt_topics": {
      "type": "string",
      "description": "Topics/headlines sent to the n8n broadcast webhook for generation"
    },
    "errorMessage": {
      "type": "string",
      "description": "Last render error"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this broadcast was published to all distribution channels (set by n8n Workflow 3)"
    },
    "distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "linkedin",
              "facebook",
              "instagram",
              "subscriber_email",
              "agent_private_label",
              "in_app_news"
            ],
            "description": "Distribution channel"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "failed"
            ],
            "default": "pending"
          },
          "recipient": {
            "type": "string",
            "description": "Who received it (e.g. 'DNN LinkedIn Page', 'All Subscribers', agent name)"
          },
          "post_id": {
            "type": "string",
            "description": "Social post ID or email message ID"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time"
          },
          "recipient_count": {
            "type": "number",
            "description": "Number of recipients (for email/agent blasts)"
          },
          "agent_id": {
            "type": "string",
            "description": "Affiliated agent ID (agent_private_label only)"
          },
          "fee": {
            "type": "number",
            "description": "Fee charged to agent for private-label distribution"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed"
          },
          "analytics": {
            "type": "object",
            "properties": {
              "impressions": {
                "type": "number"
              },
              "unique_impressions": {
                "type": "number"
              },
              "likes": {
                "type": "number"
              },
              "comments": {
                "type": "number"
              },
              "shares": {
                "type": "number"
              },
              "video_views": {
                "type": "number"
              },
              "engagement_rate": {
                "type": "number"
              },
              "previous_impressions": {
                "type": "number"
              },
              "polled_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "description": "Social media analytics pulled from platform APIs"
          }
        }
      },
      "description": "Tracks distribution of this show to social media, subscribers, and agent private-label lists"
    }
  },
  "required": [
    "broadcast_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$in": [
              "ready",
              "completed"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}