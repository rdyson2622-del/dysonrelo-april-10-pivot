{
  "name": "DnnBroadcast",
  "type": "object",
  "properties": {
    "show_name": {
      "type": "string",
      "description": "Display name for this broadcast e.g. 'Show 1', 'Show 2'"
    },
    "show_number": {
      "type": "number",
      "description": "Sequential show number for ordering"
    },
    "broadcast_date": {
      "type": "string",
      "format": "date",
      "description": "The date this broadcast covers (YYYY-MM-DD)"
    },
    "script": {
      "type": "string",
      "description": "Full anchor script covering the top headlines"
    },
    "headlines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Headlines covered in this broadcast"
    },
    "presenter": {
      "type": "string",
      "enum": [
        "bob",
        "charlie"
      ],
      "default": "charlie",
      "description": "Primary anchor for this broadcast"
    },
    "format": {
      "type": "string",
      "enum": [
        "solo",
        "tag_team"
      ],
      "default": "solo",
      "description": "solo = single anchor video; tag_team = Charlie at desk + Bob remote box"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "charlie",
              "bob"
            ]
          },
          "script": {
            "type": "string"
          },
          "heygenId": {
            "type": "string"
          },
          "videoUrl": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "Ordered clip sequence for tag_team broadcasts"
    },
    "heygenId": {
      "type": "string",
      "description": "HeyGen render job id (solo format)"
    },
    "videoUrl": {
      "type": "string",
      "description": "Permanent URL of the rendered broadcast video (solo format)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "script_ready",
        "rendering",
        "processing",
        "ready",
        "completed",
        "failed"
      ],
      "default": "draft",
      "description": "Broadcast production lifecycle. 'processing' = handed off to n8n, 'ready' = n8n callback received with final MP4."
    },
    "prompt_topics": {
      "type": "string",
      "description": "Topics/headlines sent to the n8n broadcast webhook for generation"
    },
    "errorMessage": {
      "type": "string",
      "description": "Last render error"
    },
    "distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "linkedin",
              "facebook",
              "instagram",
              "subscriber_email",
              "agent_private_label"
            ],
            "description": "Distribution channel"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "failed"
            ],
            "default": "pending"
          },
          "recipient": {
            "type": "string",
            "description": "Who received it (e.g. 'DNN LinkedIn Page', 'All Subscribers', agent name)"
          },
          "post_id": {
            "type": "string",
            "description": "Social post ID or email message ID"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time"
          },
          "recipient_count": {
            "type": "number",
            "description": "Number of recipients (for email/agent blasts)"
          },
          "agent_id": {
            "type": "string",
            "description": "Affiliated agent ID (agent_private_label only)"
          },
          "fee": {
            "type": "number",
            "description": "Fee charged to agent for private-label distribution"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed"
          },
          "analytics": {
            "type": "object",
            "properties": {
              "impressions": {
                "type": "number",
                "description": "Total views/impressions"
              },
              "unique_impressions": {
                "type": "number",
                "description": "Unique viewers"
              },
              "likes": {
                "type": "number",
                "description": "Total likes/reactions"
              },
              "comments": {
                "type": "number",
                "description": "Total comments"
              },
              "shares": {
                "type": "number",
                "description": "Total shares/reposts"
              },
              "video_views": {
                "type": "number",
                "description": "Video-specific views (for video posts)"
              },
              "engagement_rate": {
                "type": "number",
                "description": "Engagement rate as a percentage"
              },
              "previous_impressions": {
                "type": "number",
                "description": "Previous poll's impressions \u2014 for trend calculation"
              },
              "polled_at": {
                "type": "string",
                "format": "date-time",
                "description": "When analytics were last polled"
              }
            },
            "description": "Social media analytics pulled from platform APIs"
          }
        }
      },
      "description": "Tracks distribution of this show to social media, subscribers, and agent private-label lists"
    }
  },
  "required": [
    "broadcast_date"
  ]
}