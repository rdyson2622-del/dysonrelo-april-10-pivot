{
  "name": "DnnBroadcast",
  "type": "object",
  "properties": {
    "broadcast_date": {
      "type": "string",
      "format": "date",
      "description": "The date this broadcast covers (YYYY-MM-DD)"
    },
    "script": {
      "type": "string",
      "description": "Full anchor script covering the top headlines"
    },
    "headlines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Headlines covered in this broadcast"
    },
    "presenter": {
      "type": "string",
      "enum": [
        "bob",
        "charlie"
      ],
      "default": "charlie",
      "description": "Primary anchor for this broadcast"
    },
    "format": {
      "type": "string",
      "enum": [
        "solo",
        "tag_team"
      ],
      "default": "solo",
      "description": "solo = single anchor video; tag_team = Charlie at desk + Bob remote box"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "charlie",
              "bob"
            ]
          },
          "script": {
            "type": "string"
          },
          "heygenId": {
            "type": "string"
          },
          "videoUrl": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "Ordered clip sequence for tag_team broadcasts"
    },
    "heygenId": {
      "type": "string",
      "description": "HeyGen render job id (solo format)"
    },
    "videoUrl": {
      "type": "string",
      "description": "Permanent URL of the rendered broadcast video (solo format)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "script_ready",
        "rendering",
        "completed",
        "failed"
      ],
      "default": "draft",
      "description": "Broadcast production lifecycle"
    },
    "errorMessage": {
      "type": "string",
      "description": "Last render error"
    }
  },
  "required": [
    "broadcast_date"
  ]
}