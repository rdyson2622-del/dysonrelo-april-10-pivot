{
  "name": "RealEstateRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Name of the person submitting the request (optional)"
    },
    "email": {
      "type": "string",
      "description": "Email of the person submitting the request (optional)"
    },
    "context": {
      "type": "string",
      "enum": [
        "corporate_relo",
        "general"
      ],
      "default": "general",
      "description": "Where this request came from (e.g. the Corporate Relo / HR page)"
    },
    "request_text": {
      "type": "string",
      "description": "The real estate issue or request as described by the submitter"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "failed"
      ],
      "default": "processing",
      "description": "Lifecycle of the LLM roadmap generation"
    },
    "solution": {
      "type": "string",
      "description": "Plain-English solution / response generated by the LLM"
    },
    "action_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered next steps generated by the LLM"
    },
    "roadmap_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed"
            ]
          }
        }
      },
      "description": "The step-by-step roadmap generated for this specific request"
    },
    "duration_ms": {
      "type": "number",
      "description": "How long the LLM took to generate the roadmap, in milliseconds"
    }
  },
  "required": [
    "request_text"
  ]
}