{
  "name": "VendorOffering",
  "type": "object",
  "properties": {
    "industry_key": {
      "type": "string",
      "description": "Industry category linking to VendorIndustry.key"
    },
    "title": {
      "type": "string",
      "description": "Offering title (e.g. Full-service move, Luxury staging)"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description of the product/service offering"
    },
    "kind": {
      "type": "string",
      "description": "Kind of offering: product, service, package, consultation"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order within the industry"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether offering is active"
    },
    "preferred_vendor_name": {
      "type": "string",
      "description": "Associated curated preferred national provider name if applicable"
    }
  },
  "required": [
    "industry_key",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}