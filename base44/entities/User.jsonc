{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform role: admin = platform architect (full build access), user = standard account"
    },
    "portal_role": {
      "type": "string",
      "enum": [
        "client",
        "agent",
        "relocation_agent",
        "referral_agent",
        "vendor",
        "hr",
        "brokerage_admin",
        "broker"
      ],
      "description": "The single portal this subscribed user is assigned to. relocation_agent = assigned relocation specialist (call desk working board). brokerage_admin = managing broker. broker = broker. agent = agent under a brokerage."
    },
    "brokerage_id": {
      "type": "string",
      "description": "For brokerage users: the Brokerage entity ID this user is scoped to. Platform admins leave this empty."
    },
    "charlie_walkthrough_done": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user completed the Meet Charlie walkthrough session for their portal"
    },
    "charlie_walkthrough_skipped_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp if user dismissed the initial walkthrough modal without completing the session"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Whether user account is suspended"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason user was suspended"
    },
    "suspension_date": {
      "type": "string",
      "format": "date",
      "description": "Date user was suspended"
    }
  },
  "required": []
}