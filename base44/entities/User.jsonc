{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform role: admin = platform architect (full build access), user = standard account"
    },
    "portal_role": {
      "type": "string",
      "enum": [
        "client",
        "agent",
        "referral_agent",
        "vendor",
        "hr",
        "brokerage_admin"
      ],
      "description": "The single portal this subscribed user is assigned to. brokerage_admin = manages a subscribed brokerage firm (sees only their brokerage's data)"
    },
    "brokerage_id": {
      "type": "string",
      "description": "For brokerage_admin users: the Brokerage entity ID this user is scoped to. Platform admins leave this empty."
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Whether user account is suspended"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason user was suspended"
    },
    "suspension_date": {
      "type": "string",
      "format": "date",
      "description": "Date user was suspended"
    }
  },
  "required": [
    "suspension_reason",
    "suspension_date"
  ]
}