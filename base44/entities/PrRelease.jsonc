{
  "name": "PrRelease",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Release title"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier"
    },
    "campaign": {
      "type": "string",
      "default": "Dyson Homes CoPilot Ongoing Media",
      "description": "Campaign this release belongs to"
    },
    "weekLabel": {
      "type": "string",
      "description": "e.g. Week-1"
    },
    "avatarPresenter": {
      "type": "string",
      "enum": [
        "bob",
        "charlie"
      ],
      "default": "bob",
      "description": "Bob = external/public campaigns. Charlie = internal in-app explainers for Preferred Followers."
    },
    "loopDay": {
      "type": "number",
      "description": "Position (1-7) of this story in the Perpetual 7-Day Loop rotation. Day 1 is added in week 1, Day 2 joins the rotation in week 2, etc., until all 7 run daily every week."
    },
    "bannerHook": {
      "type": "string",
      "description": "Short one-line ad banner / campaign hook used for Google Search Ads headlines and social captions"
    },
    "targetAudience": {
      "type": "string",
      "description": "Primary audience this release targets, e.g. Homeowners with RE Assets"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Approved",
        "In production",
        "Distributed",
        "Archived"
      ],
      "default": "Draft"
    },
    "scriptBody": {
      "type": "string",
      "description": "Full spoken script"
    },
    "newsSummary": {
      "type": "string",
      "description": "Optional short summary used as the DNN News article body instead of the full script"
    },
    "disclosure": {
      "type": "string",
      "description": "Legal disclosure line"
    },
    "disclosureMode": {
      "type": "string",
      "enum": [
        "Spoken",
        "On-screen only",
        "Both"
      ],
      "description": "How the disclosure is delivered"
    },
    "ctaSite": {
      "type": "string",
      "default": "dysonhomes.com"
    },
    "ctaPhone": {
      "type": "string"
    },
    "ctaOffer": {
      "type": "string"
    },
    "approvedByBobAt": {
      "type": "string",
      "format": "date-time"
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "heygenVideoId": {
      "type": "string",
      "description": "HeyGen render job id for this release's Bob video, set as soon as the render is dispatched, so the Produced Video panel can auto-check and pull it in without retyping the id"
    },
    "mediaAssetUrl": {
      "type": "string"
    },
    "dnnArticleId": {
      "type": "string",
      "description": "Linked DnnArticle id created from this release's 'Post to DNN News (draft)' button"
    },
    "titleOverlayAppliedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the bannerHook lower-third title overlay was successfully burned into mediaAssetUrl via Creatomate (prReleaseTitleOverlay). Null means the current mediaAssetUrl does not have the title burned in yet."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "Distributed"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}