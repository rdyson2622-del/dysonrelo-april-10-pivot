{
  "name": "DnnArticle",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "description": "Article headline"
    },
    "dateline": {
      "type": "string",
      "description": "Dateline e.g. SAN FRANCISCO \u2014"
    },
    "body": {
      "type": "string",
      "description": "Full article body text"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video URL (YouTube, Vimeo, Loom, etc.)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL for the video"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "none",
        "new",
        "script_generated",
        "pending_review",
        "approved_for_render",
        "pending",
        "rendering",
        "complete",
        "failed",
        "needs_revision"
      ],
      "default": "none",
      "description": "Video production pipeline status"
    },
    "video_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the video render completed"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to Gemini TTS-generated audio file for this article"
    },
    "generated_opening_script": {
      "type": "string",
      "description": "AI-generated DNN branded opening script (Scene 1)"
    },
    "generated_body_script": {
      "type": "string",
      "description": "AI-generated local news story script (Scene 2)"
    },
    "generated_closing_script": {
      "type": "string",
      "description": "AI-generated Dyson & Dyson closing/outro script (Scene 3)"
    },
    "generated_full_script": {
      "type": "string",
      "description": "AI-generated complete script (opening + body + closing)"
    },
    "generated_lower_third_text": {
      "type": "string",
      "description": "AI-generated lower-third / chyron text"
    },
    "edited_opening_script": {
      "type": "string",
      "description": "Admin-edited opening script"
    },
    "edited_body_script": {
      "type": "string",
      "description": "Admin-edited body script"
    },
    "edited_closing_script": {
      "type": "string",
      "description": "Admin-edited closing script"
    },
    "edited_full_script": {
      "type": "string",
      "description": "Admin-edited full script \u2014 takes priority over generated_full_script when present"
    },
    "edited_lower_third_text": {
      "type": "string",
      "description": "Admin-edited lower-third text"
    },
    "edit_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "saved_at": {
            "type": "string",
            "format": "date-time"
          },
          "opening": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "closing": {
            "type": "string"
          }
        }
      },
      "description": "Snapshot of the previous edited_opening/body/closing_script values taken automatically right before every save, so no edit is ever silently lost. Most recent snapshot is last in the array."
    },
    "pronunciation_notes": {
      "type": "string",
      "description": "Admin pronunciation guidance for HeyGen/TTS"
    },
    "correction_notes": {
      "type": "string",
      "description": "Internal admin correction notes"
    },
    "admin_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin has approved this script for rendering"
    },
    "render_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether a render has been requested for n8n to pick up"
    },
    "render_version": {
      "type": "number",
      "default": 0,
      "description": "Increments each time a re-render is requested"
    },
    "heygen_video_id": {
      "type": "string",
      "description": "HeyGen video job ID for the current render"
    },
    "last_render_error": {
      "type": "string",
      "description": "Last render failure error message"
    },
    "scene_1_background_url": {
      "type": "string",
      "description": "Background image URL for Scene 1 (opening)"
    },
    "scene_2_background_url": {
      "type": "string",
      "description": "Background image URL for Scene 2 (body)"
    },
    "scene_3_background_url": {
      "type": "string",
      "description": "Background image URL for Scene 3 (closing)"
    },
    "interview_qa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "description": "Charlie-asks / Bob-answers interview Q&A pairs for this article"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic tags"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "tax_policy",
        "housing_market",
        "job_market",
        "interest_rates",
        "migration_data",
        "employer_news",
        "general",
        "federal_reserve",
        "mortgage_lending",
        "federal_legislation",
        "national_housing_data",
        "economic_indicators",
        "demographics_migration",
        "insurance_climate",
        "regulatory_compliance",
        "construction_supply",
        "consumer_protection"
      ],
      "description": "Category of relocation trigger \u2014 local (original) or national desk"
    },
    "scope": {
      "type": "string",
      "enum": [
        "local",
        "national"
      ],
      "default": "local",
      "description": "Whether this article covers a local market story or a national desk story"
    },
    "audience": {
      "type": "string",
      "enum": [
        "client",
        "agent",
        "vendor",
        "all"
      ],
      "default": "all",
      "description": "Primary audience this article's solution targets"
    },
    "client_solution": {
      "type": "string",
      "description": "Dyson recommendation: what a relocating client should do about this story"
    },
    "agent_solution": {
      "type": "string",
      "description": "Dyson recommendation: what a partner agent should do or say about this story"
    },
    "vendor_solution": {
      "type": "string",
      "description": "Dyson recommendation: what a vendor (lender, mover, title) should do about this story"
    },
    "status": {
      "type": "string",
      "enum": [
        "staged",
        "published",
        "blasted",
        "archived"
      ],
      "default": "staged",
      "description": "Workflow status"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the AI generated this"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "social_copy_linkedin": {
      "type": "string",
      "description": "Formatted LinkedIn post"
    },
    "social_copy_facebook": {
      "type": "string",
      "description": "Formatted Facebook post"
    },
    "placement": {
      "type": "string",
      "description": "Distribution placement slot (e.g. 'news' for the 6AM NEWS / TODAY'S CLIPS section)"
    },
    "section": {
      "type": "string",
      "description": "Website section this article targets (e.g. 'news')"
    },
    "target_live_time_local": {
      "type": "string",
      "description": "Local time-of-day the article should go live (e.g. '06:00')"
    },
    "publish_at_local": {
      "type": "string",
      "description": "Scheduled local publish time for the 6AM pipeline"
    },
    "timezone": {
      "type": "string",
      "description": "Timezone for target_live_time_local / publish_at_local (e.g. 'America/Los_Angeles')"
    },
    "render_profile": {
      "type": "string",
      "description": "External render profile identifier used by n8n (e.g. dnn_two_standing_ruben904_bob63_alpha_v2)"
    },
    "final_delivery_format": {
      "type": "string",
      "description": "Final delivery video format (e.g. 'mp4')"
    },
    "source_url": {
      "type": "string",
      "description": "Primary source URL the article was generated from (n8n source-provided mode)"
    },
    "source_name": {
      "type": "string",
      "description": "Primary source name (e.g. NAR, Redfin, Freddie Mac)"
    },
    "source_published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the primary source was published"
    },
    "source_summary": {
      "type": "string",
      "description": "Short summary of the primary source material"
    }
  },
  "required": [
    "headline",
    "body",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$in": [
              "published",
              "blasted"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}