{
  "name": "DnnArticle",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "description": "Article headline"
    },
    "dateline": {
      "type": "string",
      "description": "Dateline e.g. SAN FRANCISCO \u2014"
    },
    "body": {
      "type": "string",
      "description": "Full article body text"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video URL (YouTube, Vimeo, Loom, etc.)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL for the video"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "rendering",
        "complete",
        "failed"
      ],
      "default": "none",
      "description": "Video production pipeline status"
    },
    "video_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the video render completed"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to Gemini TTS-generated audio file for this article"
    },
    "interview_qa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "description": "Charlie-asks / Bob-answers interview Q&A pairs for this article"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic tags"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "tax_policy",
        "housing_market",
        "job_market",
        "interest_rates",
        "migration_data",
        "employer_news",
        "general"
      ],
      "description": "Category of relocation trigger"
    },
    "status": {
      "type": "string",
      "enum": [
        "staged",
        "published",
        "blasted",
        "archived"
      ],
      "default": "staged",
      "description": "Workflow status"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the AI generated this"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "social_copy_linkedin": {
      "type": "string",
      "description": "Formatted LinkedIn post"
    },
    "social_copy_facebook": {
      "type": "string",
      "description": "Formatted Facebook post"
    }
  },
  "required": [
    "headline",
    "body",
    "status"
  ]
}