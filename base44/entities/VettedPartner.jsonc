{
  "name": "VettedPartner",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "Agent's full name"
    },
    "city": {
      "type": "string",
      "description": "Primary market city"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "city_slug": {
      "type": "string",
      "description": "URL-safe city slug e.g. nashville"
    },
    "rank": {
      "type": "number",
      "description": "Rank within the city (1 = top)"
    },
    "brokerage": {
      "type": "string",
      "description": "Brokerage name"
    },
    "brokerage_category": {
      "type": "string",
      "enum": [
        "boutique_independent",
        "franchise",
        "team",
        "other"
      ],
      "default": "boutique_independent",
      "description": "Category of brokerage: Boutique Independent, Franchise, Team, or Other"
    },
    "sales_count_2025": {
      "type": "number",
      "description": "Number of transactions in 2025"
    },
    "sales_volume_2025": {
      "type": "number",
      "description": "Total sales volume in 2025 (dollars)"
    },
    "avg_price_point": {
      "type": "number",
      "description": "Average transaction price"
    },
    "phone": {
      "type": "string",
      "description": "Agent phone number (admin-only)"
    },
    "email": {
      "type": "string",
      "description": "Agent email (admin-only)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "contacted",
        "converted",
        "declined"
      ],
      "default": "pending",
      "description": "PRN membership status"
    },
    "market_type": {
      "type": "string",
      "enum": [
        "destination",
        "exodus"
      ],
      "default": "destination",
      "description": "Market role: destination (Receiver) or exodus (Sender market)"
    },
    "dre_license_number": {
      "type": "string",
      "description": "Real estate license number (e.g. CA DRE #01987654)"
    },
    "dre_license_expiration": {
      "type": "string",
      "format": "date",
      "description": "License expiration date — used for renewal alerts"
    },
    "dre_license_state": {
      "type": "string",
      "description": "State that issued the license (e.g. CA, TX, FL)"
    },
    "recruitment_source": {
      "type": "string",
      "enum": [
        "csv_import",
        "linkedin",
        "referral",
        "inbound_subscribe",
        "exodus_roster",
        "manual_entry",
        "other"
      ],
      "default": "manual_entry",
      "description": "How this recruit was sourced"
    },
    "daily_news_subscribed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this affiliate receives the DNN daily news broadcast"
    },
    "daily_news_subscribed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When daily news subscription started"
    },
    "affiliate_type": {
      "type": "string",
      "enum": [
        "sender",
        "receiver",
        "both"
      ],
      "default": "receiver",
      "description": "Affiliate role: sender (exodus market) or receiver (destination market)"
    },
    "campaigns_sent": {
      "type": "number",
      "default": 0,
      "description": "Number of recruitment campaigns this agent has received"
    },
    "last_campaign_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the last recruitment campaign was sent to this agent"
    },
    "marketing_assets_shared": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_name": {
            "type": "string"
          },
          "asset_url": {
            "type": "string"
          },
          "shared_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Marketing materials shared with this recruit (brochures, videos, pitch decks)"
    },
    "outreach_notes": {
      "type": "string",
      "description": "Internal notes on outreach / rescue cases"
    },
    "import_batch": {
      "type": "string",
      "description": "CSV batch name this record came from"
    }
  },
  "required": [
    "agent_name",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}